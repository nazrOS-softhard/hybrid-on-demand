{
  "expo": {
    "name": "Гибрид Разряд",
    "slug": "gibrid-razryad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gibridrazryad",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gibrid.razryad",
      "infoPlist": {
        "UIBackgroundModes": [],
        "NSLocationWhenInUseUsageDescription": "Гибрид Разряд использует геолокацию, чтобы определить адрес подачи мобильной электрозаправки."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gibrid.razryad",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-font",
      [
        "expo-system-ui",
        {
          "userInterfaceStyle": "dark"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "861fd3fd-6de7-45de-ad34-66b2f8b4a06c"
      }
    }
  }
}
